# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


#Ai

/.claude/
/.agents/*/
CLAUDE.md
AGENTS.md
/.windsurf/
/.codex

# editor
# .vscode se ignora salvo los archivos que el equipo comparte a proposito:
# la config de formateo y las extensiones recomendadas deben llegar a todos.
/.vscode/*
!/.vscode/settings.json
!/.vscode/extensions.json
/.idea/
